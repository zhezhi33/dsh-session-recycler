{
  "name": "dsh-session-recycler",
  "version": "0.3.0",
  "description": "DSH 会话管理插件：回收站恢复、子代理树清理、会话产物扫描与高亮、文件用途查询。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhezhi33/dsh-session-recycler.git"
  },
  "keywords": ["dsh", "dsh-plugin", "session", "cleanup", "recycle-bin"],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg", "screenshots.json", "assets", "README.md", "RELEASE.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  }
}
